// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema", "fullTextSearch"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  clerkId          String     @unique
  email            String     @unique
  username         String     @unique
  first_name       String
  last_name        String
  
  // Enhanced role management
  roles            String[]   @default(["unset"])  // All assigned roles
  primaryRole      String     @default("unset")    // Main role
  activeRole       String     @default("unset")    // Currently selected role
  roleHistory      Json[]     // Track role changes and timestamps
  
  // Role-specific profiles
  buyerProfile     Json?      // Buyer preferences, saved searches
  agentProfile     Json?      // Agent license, listings, ratings
  ownerProfile     Json?      // Owned properties, documents
  investorProfile  Json?      // Investment portfolio, preferences
  tenantProfile    Json?      // Rental history, preferences
  
  // Role-based permissions
  canList          Boolean    @default(false)      // Can create listings
  canViewAnalytics Boolean    @default(false)      // Can view advanced analytics
  customPermissions Json?     // Additional role-specific permissions
  
  // Standard fields
  image            String?
  bookedViewings   Json[]     @default([])
  favPropertiesID  String[]   @default([]) @db.ObjectId
  ownedProperties  Property[] @relation("Owner")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  lastRoleUpdate   DateTime?
  onboardingComplete Boolean  @default(false)

  @@index([primaryRole, activeRole, roles])
  @@map("users")
}

model Property {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  price       Int
  address     String
  image       String
  city        String
  country     String
  area        Int?     
  facilities  Json[]   @default([])
  ownerEmail  String
  owner       User     @relation("Owner", fields: [ownerEmail], references: [email])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([address, ownerEmail])
}
